<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Kezdőértékek a témafüggő színekhez (Indigó, világos). Futás közben a ThemeService
    felülírja őket a választott séma és mód szerint, ezért a stílusok és oldalak mindig
    DynamicResource-szal hivatkozzanak rájuk.
    Android natív színek: Platforms/Android/Resources/values/colors.xml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Séma -->
    <Color x:Key="Primary">#534AB7</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="PrimaryContainer">#EEEDFE</Color>
    <Color x:Key="OnPrimaryContainer">#26215C</Color>
    <Color x:Key="Accent">#534AB7</Color>

    <!-- Semleges -->
    <Color x:Key="Background">#F4F4F7</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceVariant">#EEEEF2</Color>
    <Color x:Key="OnSurface">#1B1B21</Color>
    <Color x:Key="OnSurfaceVariant">#6B6B76</Color>
    <Color x:Key="Outline">#C9C9D1</Color>
    <Color x:Key="OutlineVariant">#E4E4EA</Color>
    <Color x:Key="Danger">#C62828</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="#534AB7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="#EEEEF2" />
    <SolidColorBrush x:Key="OutlineBrush" Color="#C9C9D1" />
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="#E4E4EA" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C62828" />
</ResourceDictionary>
