<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Vezérlők alapstílusai és a kulcsos komponensstílusok. Minden témafüggő szín
    DynamicResource (lásd Colors.xaml és ThemeService), hogy a sémaváltás azonnal látsszon.
    Betűk: JetBrains Mono NL (AppRegular / AppMedium / AppSemiBold / AppBold).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================================
         Oldal és Shell
         ============================================================ -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Background}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource Background}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource Outline}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource Accent}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource Accent}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource OnSurfaceVariant}" />
    </Style>

    <!-- ============================================================
         Szöveg: alapstílus és tipográfiai skála
         ============================================================ -->

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontFamily" Value="AppRegular" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    </Style>

    <Style x:Key="TextBase" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontFamily" Value="AppRegular" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    </Style>

    <Style x:Key="TextDisplay" TargetType="Label" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="AppBold" />
        <Setter Property="FontSize" Value="{StaticResource FontDisplay}" />
    </Style>

    <Style x:Key="TextTitle" TargetType="Label" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="AppSemiBold" />
        <Setter Property="FontSize" Value="{StaticResource FontTitle}" />
    </Style>

    <Style x:Key="TextHeadline" TargetType="Label" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="AppSemiBold" />
        <Setter Property="FontSize" Value="{StaticResource FontHeadline}" />
    </Style>

    <Style x:Key="TextStrong" TargetType="Label" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="AppMedium" />
    </Style>

    <Style x:Key="TextCaption" TargetType="Label" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}" />
    </Style>

    <Style x:Key="TextOverline" TargetType="Label" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="AppMedium" />
        <Setter Property="FontSize" Value="{StaticResource FontOverline}" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="CharacterSpacing" Value="1" />
    </Style>

    <Style x:Key="TextLink" TargetType="Label" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="AppMedium" />
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="TextColor" Value="{DynamicResource Accent}" />
    </Style>

    <Style x:Key="TextError" TargetType="Label" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource Danger}" />
    </Style>

    <!-- Mezőcímke űrlapokon -->
    <Style x:Key="FieldLabel" TargetType="Label" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="AppMedium" />
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="Margin" Value="4,8,0,0" />
    </Style>

    <!-- ============================================================
         Kártyák és felületek
         ============================================================ -->

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource OutlineVariantBrush}" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- Kiemelő kártya a séma színével (pl. jármű a Kezdőlapon) -->
    <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- Lista csoport: sorok elválasztóval egy kártyán belül -->
    <Style x:Key="ListCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="16,4" />
    </Style>

    <!-- Kisebb csempe kártyán belül (statisztika) -->
    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariant}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource OutlineVariant}" />
        <Setter Property="HeightRequest" Value="1" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource OutlineVariant}" />
    </Style>

    <!-- ============================================================
         Gombok
         ============================================================ -->

    <!-- Alap: kitöltött, a séma színével -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
        <Setter Property="FontFamily" Value="AppSemiBold" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusButton}" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariant}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Tónusos: másodlagos művelet -->
    <Style x:Key="TonalButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainer}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryContainer}" />
        <Setter Property="FontFamily" Value="AppSemiBold" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusButton}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <!-- Szöveges: harmadlagos művelet, pl. „Összes” -->
    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Accent}" />
        <Setter Property="FontFamily" Value="AppMedium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>

    <!-- Veszélyes: törlés -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Danger}" />
        <Setter Property="BorderColor" Value="{DynamicResource Danger}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="AppSemiBold" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusButton}" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <!-- Szűrő- és szegmens-chip; kiválasztva DataTrigger állítja a ChipSelected színeit -->
    <Style x:Key="Chip" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="FontFamily" Value="AppMedium" />
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="BorderColor" Value="{DynamicResource OutlineVariant}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="MinimumWidthRequest" Value="0" />
    </Style>

    <!-- Lebegő „+” gomb a jobb alsó sarokban -->
    <Style x:Key="Fab" TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Padding" Value="17" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="Margin" Value="0,0,16,16" />
    </Style>

    <Style TargetType="ImageButton">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <!-- ============================================================
         Beviteli mezők
         ============================================================ -->

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="AppRegular" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="AppRegular" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="TitleColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="AppRegular" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="AppRegular" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="AppRegular" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource Primary}" />
        <Setter Property="ThumbColor" Value="{DynamicResource Surface}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource Primary}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontFamily" Value="AppRegular" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- ============================================================
         Egyéb
         ============================================================ -->

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource Primary}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{DynamicResource Primary}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{DynamicResource Primary}" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource Primary}" />
        <Setter Property="MaximumTrackColor" Value="{DynamicResource OutlineVariant}" />
        <Setter Property="ThumbColor" Value="{DynamicResource Primary}" />
    </Style>
</ResourceDictionary>
