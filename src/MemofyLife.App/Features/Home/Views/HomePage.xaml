<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MemofyLife.Features.Home.ViewModels"
             x:Class="MemofyLife.Features.Home.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Jármű kártya -->
            <Border Style="{StaticResource Card}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenVehicleCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="4">
                    <Label Text="🚗 Jármű" Style="{StaticResource Caption}" />

                    <VerticalStackLayout IsVisible="{Binding HasVehicle}" Spacing="4">
                        <Label Text="{Binding VehicleName}" Style="{StaticResource SectionTitle}" />
                        <Label Text="{Binding CurrentKmText}" Style="{StaticResource BigNumber}" />
                        <VerticalStackLayout IsVisible="{Binding HasReminder}" Spacing="2">
                            <Label Text="{Binding NextReminder.Title}" FontFamily="OpenSansSemibold" />
                            <Label Text="{Binding NextReminder.StatusText}"
                                   TextColor="{Binding NextReminder.StatusColor}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Label Text="Még nincs autó rögzítve. Koppints ide a hozzáadáshoz.">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasVehicle}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
