<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:MemofyLife.Common.Controls"
             xmlns:vm="clr-namespace:MemofyLife.Features.Arcade.Games.Minesweeper.ViewModels"
             x:Class="MemofyLife.Features.Arcade.Games.Minesweeper.Views.MinesweeperPage"
             x:DataType="vm:MinesweeperViewModel"
             Shell.TabBarIsVisible="False"
             Title="{Binding Title}">
    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="12"
          RowSpacing="12">

        <!-- Fejléc: hátralévő zászlók, eltelt idő, újraindítás -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,10">
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <c:TintedImage Source="flag_solid_full.png" TintColor="#D93025" WidthRequest="16" HeightRequest="16" />
                    <Label Text="{Binding FlagsLeft}" Style="{StaticResource TextHeadline}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                    <c:TintedImage Source="clock_solid_full.png" TintColor="{DynamicResource OnSurfaceVariant}" WidthRequest="16" HeightRequest="16" />
                    <Label Text="{Binding ElapsedText}" Style="{StaticResource TextHeadline}" />
                </HorizontalStackLayout>
                <Button Grid.Column="2"
                        Text="Újra"
                        Style="{StaticResource TonalButton}"
                        Command="{Binding RestartCommand}" />
            </Grid>
        </Border>

        <!-- Eredmény: játék végén jelenik meg -->
        <VerticalStackLayout Grid.Row="1"
                             IsVisible="{Binding IsGameOver}"
                             Spacing="8">
            <Label Text="{Binding ResultText}"
                   Style="{StaticResource TextTitle}"
                   HorizontalOptions="Center" />
            <Button Text="Kilépés"
                    Command="{Binding ExitCommand}"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Tábla: az oszlopszámot (Span) a code-behind állítja -->
        <CollectionView x:Name="Board"
                        Grid.Row="2"
                        ItemsSource="{Binding Cells}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:MinesweeperCellViewModel">
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 4"
                            SizeChanged="OnCellSizeChanged">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsRevealed}"
                                         Value="False">
                                <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainer}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsRevealed}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TapCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Text}"
                               FontSize="16"
                               FontFamily="AppBold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Zászló mód: koppintásra zászlót tesz felfedés helyett -->
        <HorizontalStackLayout Grid.Row="3"
                               HorizontalOptions="Center"
                               Spacing="12">
            <c:TintedImage Source="flag_solid_full.png" TintColor="#D93025" WidthRequest="16" HeightRequest="16" />
            <Label Text="Zászló mód" Style="{StaticResource TextStrong}" VerticalOptions="Center" />
            <Switch IsToggled="{Binding IsFlagMode}" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
