<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:MemofyLife.Common.Controls"
             xmlns:vm="clr-namespace:MemofyLife.Features.Arcade.Catalog.ViewModels"
             x:Class="MemofyLife.Features.Arcade.Catalog.Views.ArcadePage"
             x:DataType="vm:ArcadeViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="12">

            <VerticalStackLayout Margin="4,16,0,4" Spacing="2">
                <Label Text="{Binding Title}" Style="{StaticResource TextDisplay}" />
                <Label Text="Válassz játékot és nehézséget." Style="{StaticResource TextCaption}" />
            </VerticalStackLayout>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Games}" Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameCardViewModel">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="14">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArcadeViewModel}}, Path=OpenGameCommand, x:DataType=vm:ArcadeViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <c:IconBubble Icon="{Binding Icon}" Color="{Binding Color}" Size="48" />
                                    <Label Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           Style="{StaticResource TextHeadline}"
                                           VerticalOptions="Center" />
                                    <c:TintedImage Grid.Column="2"
                                                   Source="play_solid_full.png"
                                                   TintColor="{DynamicResource Accent}"
                                                   WidthRequest="16"
                                                   HeightRequest="16" />
                                </Grid>

                                <!-- Nehézségi szintek -->
                                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Variants}"
                                                       IsVisible="{Binding HasVariants}"
                                                       Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GameVariantItem">
                                            <Button Text="{Binding DisplayName}"
                                                    Style="{StaticResource Chip}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArcadeViewModel}}, Path=OpenVariantCommand, x:DataType=vm:ArcadeViewModel}"
                                                    CommandParameter="{Binding .}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
