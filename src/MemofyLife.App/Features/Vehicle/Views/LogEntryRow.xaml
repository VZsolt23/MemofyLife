<?xml version="1.0" encoding="utf-8" ?>
<!-- A napló egy sora: ikonbuborék, cím, részletek, összeg. Kártyán belül használatos. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:MemofyLife.Common.Controls"
             xmlns:vm="clr-namespace:MemofyLife.Features.Vehicle.ViewModels"
             x:Class="MemofyLife.Features.Vehicle.Views.LogEntryRow"
             x:DataType="vm:LogItemViewModel">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,10">
        <c:IconBubble Icon="{Binding Icon}" Color="{Binding Color}" />
        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
            <Label Text="{Binding Title}" Style="{StaticResource TextStrong}" LineBreakMode="TailTruncation" />
            <Label Text="{Binding Subtitle}" Style="{StaticResource TextCaption}" />
            <Label Text="{Binding Detail}"
                   Style="{StaticResource TextCaption}"
                   IsVisible="{Binding HasDetail}" />
        </VerticalStackLayout>
        <Label Grid.Column="2"
               Text="{Binding CostText}"
               Style="{StaticResource TextStrong}"
               VerticalOptions="Center" />
    </Grid>
</ContentView>
