<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MemofyLife.Features.Vehicle.ViewModels"
             xmlns:models="clr-namespace:MemofyLife.Vehicle.Models;assembly=MemofyLife.Vehicle"
             x:Class="MemofyLife.Features.Vehicle.Views.ReminderEditPage"
             x:DataType="vm:ReminderEditViewModel"
             Shell.TabBarIsVisible="False"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="6">

            <Label Text="Kategória" Style="{StaticResource Caption}" />
            <Picker ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory}"
                    ItemDisplayBinding="{Binding Name, x:DataType=models:ServiceCategory}" />
            <Label Text="Ilyen kategóriájú szerviz rögzítésekor az emlékeztető automatikusan teljesül."
                   Style="{StaticResource Caption}" />

            <Label Text="Megnevezés" Style="{StaticResource Caption}" Margin="0,8,0,0" />
            <Entry Text="{Binding ReminderTitle}" Placeholder="pl. Olajcsere" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Label Text="Ismétlődő" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding IsRecurring}" />
            </Grid>

            <!-- Ismétlődő: intervallum + utolsó elvégzés -->
            <VerticalStackLayout IsVisible="{Binding IsRecurring}" Spacing="6">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout>
                        <Label Text="Ennyi km-enként" Style="{StaticResource Caption}" />
                        <Entry Text="{Binding IntervalKmText}" Keyboard="Numeric" Placeholder="pl. 15000" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Ennyi havonta" Style="{StaticResource Caption}" />
                        <Entry Text="{Binding IntervalMonthsText}" Keyboard="Numeric" Placeholder="pl. 12" />
                    </VerticalStackLayout>
                </Grid>
                <Label Text="Elég az egyiket megadni; ha mindkettő van, amelyik előbb jön." Style="{StaticResource Caption}" />

                <Label Text="Utoljára elvégezve (km)" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                <Entry Text="{Binding LastDoneKmText}" Keyboard="Numeric" />
                <Label Text="Utoljára elvégezve (dátum)" Style="{StaticResource Caption}" />
                <DatePicker Date="{Binding LastDoneDate}" Format="yyyy. MM. dd." />
            </VerticalStackLayout>

            <!-- Egyszeri: közvetlen esedékesség -->
            <VerticalStackLayout IsVisible="{Binding IsOneOff}" Spacing="6">
                <Label Text="Esedékes km-állás" Style="{StaticResource Caption}" />
                <Entry Text="{Binding DueKmText}" Keyboard="Numeric" Placeholder="nem kötelező" />
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Esedékes dátum" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding HasDueDate}" />
                </Grid>
                <DatePicker Date="{Binding DueDate}"
                            Format="yyyy. MM. dd."
                            IsVisible="{Binding HasDueDate}" />
            </VerticalStackLayout>

            <!-- Előzetes jelzés -->
            <Label Text="Mikortól jelezzen előre?" Style="{StaticResource SectionTitle}" Margin="0,12,0,0" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout>
                    <Label Text="km-rel előtte" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding NotifyBeforeKmText}"
                           Keyboard="Numeric"
                           Placeholder="{Binding NotifyKmPlaceholder}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="nappal előtte" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding NotifyBeforeDaysText}"
                           Keyboard="Numeric"
                           Placeholder="{Binding NotifyDaysPlaceholder}" />
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsEdit}" Margin="0,8,0,0">
                <Label Text="Aktív" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding IsActive}" />
            </Grid>

            <Label Text="{Binding ErrorText}"
                   Style="{StaticResource ErrorText}"
                   IsVisible="{Binding HasError}"
                   Margin="0,8,0,0" />

            <Button Text="Mentés" Command="{Binding SaveCommand}" Margin="0,12,0,0" />
            <Button Text="Törlés"
                    Style="{StaticResource DangerButton}"
                    Command="{Binding DeleteCommand}"
                    IsVisible="{Binding IsEdit}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
