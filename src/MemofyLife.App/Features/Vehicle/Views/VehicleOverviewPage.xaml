<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:MemofyLife.Common.Controls"
             xmlns:theme="clr-namespace:MemofyLife.Common.Theming"
             xmlns:views="clr-namespace:MemofyLife.Features.Vehicle.Views"
             xmlns:vm="clr-namespace:MemofyLife.Features.Vehicle.ViewModels"
             x:Class="MemofyLife.Features.Vehicle.Views.VehicleOverviewPage"
             x:DataType="vm:VehicleOverviewViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}">

    <Grid>
        <!-- Üres állapot: még nincs jármű -->
        <c:EmptyState IsVisible="{Binding HasNoVehicle}"
                      Icon="car_solid_full.png"
                      Color="{x:Static theme:SemanticColors.Vehicle}"
                      Title="Add meg az autódat"
                      Message="Utána rögzítheted a km-állást, a tankolásokat és a szervizeket."
                      ActionText="Autó hozzáadása"
                      Command="{Binding AddVehicleCommand}" />

        <ScrollView IsVisible="{Binding HasVehicle}">
            <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="12">

                <!-- Fejléc -->
                <Grid ColumnDefinitions="*,Auto" Margin="4,16,0,4">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding VehicleName}" Style="{StaticResource TextDisplay}" />
                        <Label Text="{Binding VehicleDetails}" Style="{StaticResource TextCaption}" />
                    </VerticalStackLayout>
                    <c:IconAction Grid.Column="1"
                                  Icon="pen_solid_full.png"
                                  Description="Jármű szerkesztése"
                                  Command="{Binding EditVehicleCommand}" />
                </Grid>

                <!-- Számok -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="KILOMÉTERÓRA" Style="{StaticResource TextOverline}" />
                            <Label Text="{Binding CurrentKmText}" Style="{StaticResource TextDisplay}" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Border Style="{StaticResource Tile}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="E havi költség" Style="{StaticResource TextCaption}" />
                                    <Label Text="{Binding MonthCostText}" Style="{StaticResource TextStrong}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Tile}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Átlagfogyasztás" Style="{StaticResource TextCaption}" />
                                    <Label Text="{Binding ConsumptionText}" Style="{StaticResource TextStrong}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Gyors rögzítés -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Style="{StaticResource Card}" Padding="8,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddEntryCommand}" CommandParameter="Odometer" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <c:IconBubble Icon="gauge_high_solid_full.png"
                                          Color="{x:Static theme:SemanticColors.Odometer}"
                                          HorizontalOptions="Center" />
                            <Label Text="Km" Style="{StaticResource TextStrong}" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="8,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddEntryCommand}" CommandParameter="Fuel" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <c:IconBubble Icon="gas_pump_solid_full.png"
                                          Color="{x:Static theme:SemanticColors.Fuel}"
                                          HorizontalOptions="Center" />
                            <Label Text="Tankolás" Style="{StaticResource TextStrong}" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddEntryCommand}" CommandParameter="Service" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <c:IconBubble Icon="wrench_solid_full.png"
                                          Color="{x:Static theme:SemanticColors.Service}"
                                          HorizontalOptions="Center" />
                            <Label Text="Szerviz" Style="{StaticResource TextStrong}" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Karbantartás -->
                <c:SectionHeader Title="Karbantartás"
                                 ActionText="+ Új"
                                 Command="{Binding AddReminderCommand}" />

                <Border Style="{StaticResource Card}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding HasReminders}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Még nincs emlékeztető. Adj hozzá például olajcserét vagy műszaki vizsgát."
                           Style="{StaticResource TextCaption}" />
                </Border>

                <Border Style="{StaticResource ListCard}" IsVisible="{Binding HasReminders}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Reminders}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReminderItemViewModel">
                                <views:ReminderRow>
                                    <views:ReminderRow.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VehicleOverviewViewModel}}, Path=OpenReminderCommand, x:DataType=vm:VehicleOverviewViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </views:ReminderRow.GestureRecognizers>
                                </views:ReminderRow>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Legutóbbi bejegyzések -->
                <c:SectionHeader Title="Legutóbbi"
                                 ActionText="Napló"
                                 Command="{Binding OpenLogCommand}" />

                <Border Style="{StaticResource Card}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding HasEntries}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Még nincs bejegyzés. Kezdd egy km-állással vagy tankolással."
                           Style="{StaticResource TextCaption}" />
                </Border>

                <Border Style="{StaticResource ListCard}" IsVisible="{Binding HasEntries}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentEntries}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogItemViewModel">
                                <views:LogEntryRow>
                                    <views:LogEntryRow.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VehicleOverviewViewModel}}, Path=OpenEntryCommand, x:DataType=vm:VehicleOverviewViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </views:LogEntryRow.GestureRecognizers>
                                </views:LogEntryRow>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
