<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MemofyLife.Features.Vehicle.ViewModels"
             x:Class="MemofyLife.Features.Vehicle.Views.VehicleEditPage"
             x:DataType="vm:VehicleEditViewModel"
             Shell.TabBarIsVisible="False"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="6">
            <Label Text="Név" Style="{StaticResource Caption}" />
            <Entry Text="{Binding Name}" Placeholder="Saját autó" />

            <Label Text="Gyártó" Style="{StaticResource Caption}" />
            <Entry Text="{Binding Make}" Placeholder="pl. Toyota" />

            <Label Text="Típus" Style="{StaticResource Caption}" />
            <Entry Text="{Binding Model}" Placeholder="pl. Corolla" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout>
                    <Label Text="Évjárat" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding ModelYearText}" Keyboard="Numeric" Placeholder="2018" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Rendszám" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding LicensePlate}" Placeholder="ABC-123" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="Üzemanyag" Style="{StaticResource Caption}" />
            <Picker ItemsSource="{Binding FuelTypes}"
                    SelectedItem="{Binding SelectedFuelType}"
                    ItemDisplayBinding="{Binding Label, x:DataType=vm:FuelTypeOption}"
                    Title="Válassz" />

            <Label Text="Kezdő km-állás" Style="{StaticResource Caption}" />
            <Entry Text="{Binding InitialKmText}" Keyboard="Numeric" />
            <Label Text="Az óraállás az első bejegyzés előtt; ennél kisebb km-re figyelmeztetünk."
                   Style="{StaticResource Caption}" />

            <Label Text="{Binding ErrorText}"
                   Style="{StaticResource ErrorText}"
                   IsVisible="{Binding HasError}"
                   Margin="0,8,0,0" />

            <Button Text="Mentés" Command="{Binding SaveCommand}" Margin="0,12,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
