<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MemofyLife.Features.Vehicle.ViewModels"
             x:Class="MemofyLife.Features.Vehicle.Views.VehicleEditPage"
             x:DataType="vm:VehicleEditViewModel"
             Shell.TabBarIsVisible="False"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="12">

            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Név" Style="{StaticResource FieldLabel}" Margin="4,0,0,0" />
                    <Entry Text="{Binding Name}" Placeholder="Saját autó" />

                    <Label Text="Gyártó" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Make}" Placeholder="Toyota" />

                    <Label Text="Típus" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Model}" Placeholder="Corolla" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Évjárat" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding ModelYearText}" Keyboard="Numeric" Placeholder="2018" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Rendszám" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding LicensePlate}" Placeholder="ABC-123" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Üzemanyag" Style="{StaticResource FieldLabel}" />
                    <Picker ItemsSource="{Binding FuelTypes}"
                            SelectedItem="{Binding SelectedFuelType}"
                            ItemDisplayBinding="{Binding Label, x:DataType=vm:FuelTypeOption}"
                            Title="Válassz" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Kezdő km-állás" Style="{StaticResource FieldLabel}" Margin="4,0,0,0" />
                    <Entry Text="{Binding InitialKmText}" Keyboard="Numeric" />
                    <Label Text="Az óraállás az első bejegyzés előtt. Ennél kisebb km-re figyelmeztetünk."
                           Style="{StaticResource TextCaption}"
                           Margin="4,0,0,0" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorText}"
                   Style="{StaticResource TextError}"
                   IsVisible="{Binding HasError}"
                   Margin="4,0" />

            <Button Text="Mentés" Command="{Binding SaveCommand}" Margin="0,4,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
