<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MemofyLife.Features.Vehicle.ViewModels"
             x:Class="MemofyLife.Features.Vehicle.Views.VehicleLogPage"
             x:DataType="vm:VehicleLogViewModel"
             Shell.TabBarIsVisible="False"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Új" Command="{Binding AddEntryCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16,12,16,0" RowSpacing="12">

        <!-- Szűrő -->
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
            <Button Text="Mind"
                    Style="{StaticResource SegmentButton}"
                    Command="{Binding SetFilterCommand}"
                    CommandParameter="">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsAll}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1"
                    Text="Km"
                    Style="{StaticResource SegmentButton}"
                    Command="{Binding SetFilterCommand}"
                    CommandParameter="Odometer">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsOdometer}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="2"
                    Text="Tankolás"
                    Style="{StaticResource SegmentButton}"
                    Command="{Binding SetFilterCommand}"
                    CommandParameter="Fuel">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsFuel}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="3"
                    Text="Szerviz"
                    Style="{StaticResource SegmentButton}"
                    Command="{Binding SetFilterCommand}"
                    CommandParameter="Service">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsService}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Nincs ilyen bejegyzés."
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Center"
                           Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogItemViewModel">
                        <Border Style="{StaticResource Card}" Padding="12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VehicleLogViewModel}}, Path=OpenEntryCommand, x:DataType=vm:VehicleLogViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label Text="{Binding Icon}" FontSize="22" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" />
                                    <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding Detail}"
                                           Style="{StaticResource Caption}"
                                           IsVisible="{Binding HasDetail}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="{Binding CostText}"
                                       FontFamily="OpenSansSemibold"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
