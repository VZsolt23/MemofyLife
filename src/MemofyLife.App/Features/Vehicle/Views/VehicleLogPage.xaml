<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:MemofyLife.Common.Controls"
             xmlns:theme="clr-namespace:MemofyLife.Common.Theming"
             xmlns:views="clr-namespace:MemofyLife.Features.Vehicle.Views"
             xmlns:vm="clr-namespace:MemofyLife.Features.Vehicle.ViewModels"
             x:Class="MemofyLife.Features.Vehicle.Views.VehicleLogPage"
             x:DataType="vm:VehicleLogViewModel"
             Shell.TabBarIsVisible="False"
             Title="{Binding Title}">


    <Grid RowDefinitions="Auto,*">

        <!-- Szűrő -->
        <HorizontalStackLayout Padding="16,4,16,8" Spacing="8">
            <Button Text="Mind" Style="{StaticResource Chip}" Command="{Binding SetFilterCommand}" CommandParameter="">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsAll}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                        <Setter Property="BorderColor" Value="{DynamicResource Primary}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Text="Km" Style="{StaticResource Chip}" Command="{Binding SetFilterCommand}" CommandParameter="Odometer">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsOdometer}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                        <Setter Property="BorderColor" Value="{DynamicResource Primary}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Text="Tankolás" Style="{StaticResource Chip}" Command="{Binding SetFilterCommand}" CommandParameter="Fuel">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsFuel}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                        <Setter Property="BorderColor" Value="{DynamicResource Primary}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Text="Szerviz" Style="{StaticResource Chip}" Command="{Binding SetFilterCommand}" CommandParameter="Service">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsService}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                        <Setter Property="BorderColor" Value="{DynamicResource Primary}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Groups}"
                            IsGrouped="True"
                            SelectionMode="None"
                            Margin="16,0">
                <CollectionView.EmptyView>
                    <c:EmptyState Icon="list_solid_full.png"
                                  Color="{x:Static theme:SemanticColors.Neutral}"
                                  Title="Nincs ilyen bejegyzés"
                                  Message="A „+” gombbal rögzíthetsz újat." />
                </CollectionView.EmptyView>

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:LogMonthGroup">
                        <Grid ColumnDefinitions="*,Auto" Padding="4,16,4,8">
                            <Label Text="{Binding Title}" Style="{StaticResource TextHeadline}" />
                            <Label Grid.Column="1"
                                   Text="{Binding TotalText}"
                                   Style="{StaticResource TextCaption}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogItemViewModel">
                        <Border Style="{StaticResource Card}" Padding="14,2" Margin="0,0,0,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VehicleLogViewModel}}, Path=OpenEntryCommand, x:DataType=vm:VehicleLogViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <views:LogEntryRow />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Hely a lebegő gombnak a lista végén -->
                <CollectionView.Footer>
                    <BoxView HeightRequest="88" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <c:FabButton Grid.Row="1"
                     Icon="plus_solid_full.png"
                     Command="{Binding AddEntryCommand}" />
    </Grid>
</ContentPage>
