<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:MemofyLife.Common.Controls"
             xmlns:theme="clr-namespace:MemofyLife.Common.Theming"
             xmlns:vm="clr-namespace:MemofyLife.Features.Vehicle.ViewModels"
             xmlns:models="clr-namespace:MemofyLife.Vehicle.Models;assembly=MemofyLife.Vehicle"
             x:Class="MemofyLife.Features.Vehicle.Views.EntryEditPage"
             x:DataType="vm:EntryEditViewModel"
             Shell.TabBarIsVisible="False"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="12">

            <!-- Típus: három csempe, a kiválasztott a séma színével keretezve -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,8,0,0">
                <Border Style="{StaticResource Card}" Padding="8,12" StrokeThickness="2" Stroke="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTypeCommand}" CommandParameter="Odometer" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsOdometer}" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainer}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout Spacing="6">
                        <c:IconBubble Icon="gauge_high_solid_full.png" Color="{x:Static theme:SemanticColors.Odometer}" HorizontalOptions="Center" Size="36" />
                        <Label Text="Km" Style="{StaticResource TextStrong}" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="8,12" StrokeThickness="2" Stroke="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTypeCommand}" CommandParameter="Fuel" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsFuel}" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainer}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout Spacing="6">
                        <c:IconBubble Icon="gas_pump_solid_full.png" Color="{x:Static theme:SemanticColors.Fuel}" HorizontalOptions="Center" Size="36" />
                        <Label Text="Tankolás" Style="{StaticResource TextStrong}" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8,12" StrokeThickness="2" Stroke="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTypeCommand}" CommandParameter="Service" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsService}" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainer}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout Spacing="6">
                        <c:IconBubble Icon="wrench_solid_full.png" Color="{x:Static theme:SemanticColors.Service}" HorizontalOptions="Center" Size="36" />
                        <Label Text="Szerviz" Style="{StaticResource TextStrong}" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Alapadatok -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Dátum" Style="{StaticResource FieldLabel}" Margin="4,0,0,0" />
                    <DatePicker Date="{Binding Date}" Format="yyyy. MM. dd." />

                    <Label Text="Km-állás" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding OdometerText}" Keyboard="Numeric" Placeholder="128450" />
                    <Label Text="{Binding LastKmHint}" Style="{StaticResource TextCaption}" Margin="4,0,0,0" />

                    <VerticalStackLayout IsVisible="{Binding HasCost}" Spacing="2">
                        <Label Text="Összeg (Ft)" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding CostText}" Keyboard="Numeric" Placeholder="22000" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Tankolás -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsFuel}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Mennyiség (liter)" Style="{StaticResource FieldLabel}" Margin="4,0,0,0" />
                    <Entry Text="{Binding LitersText}" Keyboard="Numeric" Placeholder="38,4" />
                    <Grid ColumnDefinitions="*,Auto" Margin="4,8,0,0">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Teli tank" Style="{StaticResource TextStrong}" />
                            <Label Text="A fogyasztás két teli tankolás között pontos."
                                   Style="{StaticResource TextCaption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding IsFullTank}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Szerviz -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsService}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Kategória" Style="{StaticResource FieldLabel}" Margin="4,0,0,0" />
                    <Picker ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory}"
                            ItemDisplayBinding="{Binding Name, x:DataType=models:ServiceCategory}"
                            Title="Válassz kategóriát" />
                    <Label Text="Leírás" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Description}" Placeholder="Első fékbetét és tárcsa" />
                    <Label Text="Műhely" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Workshop}" Placeholder="Kovács Autószerviz" />
                </VerticalStackLayout>
            </Border>

            <!-- Megjegyzés -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Megjegyzés" Style="{StaticResource FieldLabel}" Margin="4,0,0,0" />
                    <Editor Text="{Binding Note}" AutoSize="TextChanges" Placeholder="Nem kötelező" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorText}"
                   Style="{StaticResource TextError}"
                   IsVisible="{Binding HasError}"
                   Margin="4,0" />

            <Button Text="Mentés" Command="{Binding SaveCommand}" Margin="0,4,0,0" />
            <Button Text="Törlés"
                    Style="{StaticResource DangerButton}"
                    Command="{Binding DeleteCommand}"
                    IsVisible="{Binding IsEdit}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
