<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MemofyLife.Features.Arcade.Catalog.Views.ArcadePage"
             xmlns:vm="clr-namespace:MemofyLife.Features.Arcade.Catalog.ViewModels"
             xmlns:shared="clr-namespace:MemofyLife.Features.Arcade.Shared"
             x:DataType="vm:ArcadeViewModel"
             Title="{Binding Title}">
    <CollectionView ItemsSource="{Binding Games}" SelectionMode="None">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="shared:IGame">
                <Border Padding="16" Margin="16,8">
                    <Label Text="{Binding DisplayName}" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArcadeViewModel}}, Path=OpenGameCommand}"
                            CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
